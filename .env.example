# Copy to .env and fill in. Never commit .env.

# Local Postgres (docker-compose.yml)
POSTGRES_USER=bidesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bidesk
DATABASE_URL=postgresql://bidesk:change-me@localhost:5432/bidesk

# Model APIs, used only by src/bidesk/llm.py
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Daily spend cap enforced by llm.py
BIDESK_DAILY_SPEND_CAP_USD=2.00
